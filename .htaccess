# .htaccess
# Redirectioneaza toate cererile catre index.php (front controller)
# Protejeaza fisierele sensibile si seteaza headere de securitate


# ===== Rescriere URL =====

RewriteEngine On
RewriteBase /docgen/

# Fisierele si folderele care exista fizic pe disk trec direct (CSS, JS, imagini etc.)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Orice alta cerere e redirectionata catre index.php (QSA pastreaza parametrii GET)
RewriteRule ^(.*)$ index.php [QSA,L]


# ===== Protectie fisiere sensibile =====

# Baza de date SQLite
<Files "database.sqlite">
    Order Allow,Deny
    Deny from all
</Files>

# Fisier de configurare
<Files "config.php">
    Order Allow,Deny
    Deny from all
</Files>

# Fisiere SQL
<Files "*.sql">
    Order Allow,Deny
    Deny from all
</Files>

# Fisiere JSON din templates/ (acces doar prin API, nu direct)
RewriteRule ^templates/.*\.json$ - [F,L]


# ===== Headere de securitate =====

# Previne clickjacking
Header always set X-Frame-Options "SAMEORIGIN"

# Previne MIME sniffing
Header always set X-Content-Type-Options "nosniff"

# Activeaza protectia XSS in browser
Header always set X-XSS-Protection "1; mode=block"

# Ascunde versiunea de PHP
<IfModule mod_headers.c>
    Header unset X-Powered-By
</IfModule>


# ===== Altele =====

AddDefaultCharset UTF-8